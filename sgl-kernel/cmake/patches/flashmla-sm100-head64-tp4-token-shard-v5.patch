+// TP4 C4-prefill specialization.  NCCL receives Q as
+// [source_rank, token_shard, local_head, dim].  Describe the source-rank and
+// local-head modes as one hierarchical 64-head TMA mode, avoiding a 1--2 GiB
+// relayout kernel.  The epilogue writes [destination_rank, token_shard,
+// local_head, dim], which is directly consumable by the return all-to-all.
+template<int D_QK>
+void run_fwd_phase1_tp4_sharded_output_kernel(
+    const SparseAttnFwdParams& params) {
+    KU_ASSERT(params.h_kv == 1);
+    KU_ASSERT(params.topk % B_TOPK == 0);
+    KU_ASSERT(params.h_q == B_H);
+    KU_ASSERT(params.d_qk == D_QK);
+    static_assert(D_QK == 512);
+    constexpr int kLocalHeads = 16;
+    constexpr int kWorldSize = 4;
+    static_assert(kLocalHeads * kWorldSize == B_H);
+
+    auto shape_Q_nope = make_shape(
+        make_shape(Int<kLocalHeads>{}, Int<kWorldSize>{}),
+        Int<D_V>{},
+        params.s_q);
+    auto stride_Q = make_stride(
+        make_stride(
+            Int<D_QK>{},
+            params.s_q * kLocalHeads * D_QK),
+        _1{},
+        Int<kLocalHeads * D_QK>{});
+    auto tma_Q_nope = cute::make_tma_copy(
+        SM90_TMA_LOAD{},
+        make_tensor(
+            make_gmem_ptr((bf16*)params.q),
+            make_layout(shape_Q_nope, stride_Q)),
+        SmemLayoutQNoPE{});
+
+    auto shape_Q_rope = make_shape(
+        make_shape(Int<kLocalHeads>{}, Int<kWorldSize>{}),
+        Int<D_Q-D_V>{},
+        params.s_q);
+    auto tma_Q_rope = cute::make_tma_copy(
+        SM90_TMA_LOAD{},
+        make_tensor(
+            make_gmem_ptr((bf16*)params.q + D_V),
+            make_layout(shape_Q_rope, stride_Q)),
+        SmemLayoutQRoPE{});
+
+    // The TP4 epilogue bypasses this descriptor, but keeping a valid output
+    // TMA object preserves the common kernel parameter type and launch path.
+    auto shape_O = make_shape(params.h_q, params.d_v, params.s_q);
+    auto tma_O = cute::make_tma_copy(
+        SM90_TMA_STORE{},
+        make_tensor(
+            make_gmem_ptr((bf16*)params.out),
+            make_layout(
+                shape_O,
+                make_stride(params.d_v, _1{}, params.h_q*params.d_v))),
+        SmemLayoutOTiles<1>{});
+
+    CUtensorMap tensor_map_kv_nope;
+    {
+        uint64_t size[2] = {D_V, (unsigned long)params.s_kv};
+        uint64_t stride[1] = {params.stride_kv_s_kv*sizeof(bf16)};
+        uint32_t box_size[2] = {64, 1};
+        uint32_t elem_stride[2] = {1, 1};
+        CUresult res = CUTLASS_CUDA_DRIVER_WRAPPER_CALL(cuTensorMapEncodeTiled)(
+            &tensor_map_kv_nope,
+            CUtensorMapDataType::CU_TENSOR_MAP_DATA_TYPE_BFLOAT16,
+            2,
+            params.kv,
+            size,
+            stride,
+            box_size,
+            elem_stride,
+            CUtensorMapInterleave::CU_TENSOR_MAP_INTERLEAVE_NONE,
+            CUtensorMapSwizzle::CU_TENSOR_MAP_SWIZZLE_128B,
+            CUtensorMapL2promotion::CU_TENSOR_MAP_L2_PROMOTION_L2_256B,
+            CUtensorMapFloatOOBfill::CU_TENSOR_MAP_FLOAT_OOB_FILL_NONE);
+        KU_ASSERT(res == CUresult::CUDA_SUCCESS);
+    }
+
+    TmaParams<
+        decltype(shape_Q_nope), decltype(tma_Q_nope),
+        decltype(shape_Q_rope), decltype(tma_Q_rope),
+        decltype(shape_O), decltype(tma_O)>
+    tma_params = {
+        shape_Q_nope, tma_Q_nope,
+        shape_Q_rope, tma_Q_rope,
+        shape_O, tma_O,
+        tensor_map_kv_nope};
+    auto kernel = &sparse_attn_fwd_kernel<
+        false, false, B_H, true, decltype(tma_params)>;
+    constexpr size_t smem_size = sizeof(SharedMemoryPlan);
+    KU_CUDA_CHECK(cudaFuncSetAttribute(
+        kernel, cudaFuncAttributeMaxDynamicSharedMemorySize, smem_size));
+    kernel<<<params.s_q, NUM_THREADS, smem_size, params.stream>>>(
+        params, tma_params);
+    KU_CHECK_KERNEL_LAUNCH();
+}
