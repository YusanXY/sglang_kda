+// TP4 peer-Q specialization.  Every producer rank keeps its normalized Q in
+// one symmetric [global_token, 16, 512] buffer.  The destination rank selects
+// its token quarter from all four peer mappings and TMA-loads the four head
+// slices directly into FlashMLA shared memory.  This removes the standalone
+// peer write router and its local receive buffer traffic.
+template<int D_QK>
+void run_fwd_phase1_tp4_peer_q_output_kernel(
+    const SparseAttnFwdParams& params,
+    bf16* q_peer_0,
+    bf16* q_peer_1,
+    bf16* q_peer_2,
+    bf16* q_peer_3,
+    int total_s_q,
+    int token_shard_rank) {
+    KU_ASSERT(params.h_kv == 1);
+    KU_ASSERT(params.topk % B_TOPK == 0);
+    KU_ASSERT(params.h_q == B_H);
+    KU_ASSERT(params.d_qk == D_QK);
+    KU_ASSERT(token_shard_rank >= 0 && token_shard_rank < 4);
+    KU_ASSERT(total_s_q == params.s_q * 4);
+    static_assert(D_QK == 512);
+    constexpr int kLocalHeads = 16;
+    constexpr int kWorldSize = 4;
+    static_assert(kLocalHeads * kWorldSize == B_H);
+
+    const int64_t token_offset =
+        static_cast<int64_t>(token_shard_rank) * params.s_q;
+    const int64_t element_offset =
+        token_offset * kLocalHeads * D_QK;
+    auto shape_Q_nope = make_shape(
+        Int<kLocalHeads>{}, Int<64>{}, Int<D_V / 64>{}, params.s_q);
+    auto stride_Q = make_stride(
+        Int<D_QK>{}, _1{}, Int<64>{}, Int<kLocalHeads * D_QK>{});
+    auto make_peer_q_tma = [&](bf16* q_peer) {
+        return cute::make_tma_copy(
+            SM90_TMA_LOAD{},
+            make_tensor(
+                make_gmem_ptr(q_peer + element_offset),
+                make_layout(shape_Q_nope, stride_Q)),
+            SmemLayoutQNoPEPeerTile{});
+    };
+    auto tma_Q_nope_0 = make_peer_q_tma(q_peer_0);
+    auto tma_Q_nope_1 = make_peer_q_tma(q_peer_1);
+    auto tma_Q_nope_2 = make_peer_q_tma(q_peer_2);
+    auto tma_Q_nope_3 = make_peer_q_tma(q_peer_3);
+
+    auto shape_O = make_shape(params.h_q, params.d_v, params.s_q);
+    auto tma_O = cute::make_tma_copy(
+        SM90_TMA_STORE{},
+        make_tensor(
+            make_gmem_ptr((bf16*)params.out),
+            make_layout(
+                shape_O,
+                make_stride(params.d_v, _1{}, params.h_q * params.d_v))),
+        SmemLayoutOTiles<1>{});
+
+    CUtensorMap tensor_map_kv_nope;
+    {
+        uint64_t size[2] = {D_V, (unsigned long)params.s_kv};
+        uint64_t stride[1] = {params.stride_kv_s_kv * sizeof(bf16)};
+        uint32_t box_size[2] = {64, 1};
+        uint32_t elem_stride[2] = {1, 1};
+        CUresult res = CUTLASS_CUDA_DRIVER_WRAPPER_CALL(
+            cuTensorMapEncodeTiled)(
+                &tensor_map_kv_nope,
+                CUtensorMapDataType::CU_TENSOR_MAP_DATA_TYPE_BFLOAT16,
+                2,
+                params.kv,
+                size,
+                stride,
+                box_size,
+                elem_stride,
+                CUtensorMapInterleave::CU_TENSOR_MAP_INTERLEAVE_NONE,
+                CUtensorMapSwizzle::CU_TENSOR_MAP_SWIZZLE_128B,
+                CUtensorMapL2promotion::CU_TENSOR_MAP_L2_PROMOTION_L2_256B,
+                CUtensorMapFloatOOBfill::CU_TENSOR_MAP_FLOAT_OOB_FILL_NONE);
+        KU_ASSERT(res == CUresult::CUDA_SUCCESS);
+    }
+
+    Tp4PeerQTmaParams<
+        decltype(shape_Q_nope), decltype(tma_Q_nope_0),
+        decltype(shape_O), decltype(tma_O)>
+    tma_params = {
+        shape_Q_nope,
+        tma_Q_nope_0,
+        tma_Q_nope_1,
+        tma_Q_nope_2,
+        tma_Q_nope_3,
+        shape_O,
+        tma_O,
+        tensor_map_kv_nope};
+    auto kernel = &sparse_attn_fwd_kernel<
+        false, false, B_H, true, true, decltype(tma_params)>;
     constexpr size_t smem_size = sizeof(SharedMemoryPlan);
     KU_CUDA_CHECK(cudaFuncSetAttribute(
         kernel, cudaFuncAttributeMaxDynamicSharedMemorySize, smem_size));
