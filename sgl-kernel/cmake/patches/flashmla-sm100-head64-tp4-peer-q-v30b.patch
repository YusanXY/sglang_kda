+// A 64x512 UMMA K-major tile interleaves the four 16-head groups inside every
+// 64-column swizzle atom.  Therefore a peer cannot target one compact 16x512
+// slice.  Use the exact 16x64 atom sub-tile and place eight of them at the
+// parent layout's explicit (column_tile, peer) offsets.
+using SmemLayoutQNoPEPeerTile = decltype(coalesce(tile_to_shape(
+    UMMA::Layout_K_SW128_Atom<bf16>{},
+    Shape<Int<B_H / 4>, Int<64>>{},
+    Step<_1, _2>{}
+), Shape<_1, _1>{}));
